ADDR=:8080
DATABASE_URL=postgres://ledger:ledger@localhost:5432/ledger?sslmode=disable
# key:principal pairs; the principal scopes rate limits and idempotency keys
API_KEYS=dev-key:local-dev,other-key:partner-x
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=20s
ENABLE_PPROF=false

RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
IDEMPOTENCY_TTL=24h

OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=10

# Leave WEBHOOK_URL empty to log events instead of delivering them.
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_TIMEOUT=5s
BREAKER_FAILURE_THRESHOLD=5
BREAKER_OPEN_TIMEOUT=30s
